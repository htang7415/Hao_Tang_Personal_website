{
  "name": "hao-tang-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:repo": "python3 scripts/check_repo.py",
    "check:build": "node scripts/check_build.mjs",
    "verify": "npm run check:repo && python3 -m unittest discover -s tests -v && npm run typecheck && npm test && npm run build && npm run check:build"
  },
  "dependencies": {
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.14.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^5.0.0",
    "gray-matter": "^4.0.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "3.2.7"
  }
}
